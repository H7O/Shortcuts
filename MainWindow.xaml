<Window x:Class="Shortcuts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shortcuts"
        mc:Ignorable="d"
        Title="Shortcuts" Height="500" Width="420"
        MinHeight="300" MinWidth="320"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackground}"
        Icon="pack://application:,,,/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource ToolbarBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFolderButton" Click="AddFolderButton_Click"
                        FontSize="14" Padding="12,6" Cursor="Hand"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Add Folder" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddFileButton" Click="AddFileButton_Click"
                        FontSize="14" Padding="12,6" Margin="8,0,0,0" Cursor="Hand"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        BorderBrush="{DynamicResource ButtonBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Add File" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" x:Name="EmptyMessage"
                   Text="No shortcuts yet. Click 'Add Folder' or 'Add File', or drop items here from Explorer."
                   TextWrapping="Wrap" TextAlignment="Center" Margin="24,0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource EmptyMessageForeground}" FontSize="14" Visibility="Visible"/>

        <!-- Shortcuts list. A click on a row opens it; a drag only starts from the row's drag handle. -->
        <ListBox Grid.Row="1" x:Name="ShortcutsList"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="ShortcutsList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ShortcutsList_PreviewMouseMove"
                 PreviewMouseLeftButtonUp="ShortcutsList_PreviewMouseLeftButtonUp"
                 Drop="ShortcutsList_Drop"
                 DragOver="ShortcutsList_DragOver"
                 Background="Transparent">
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource ListItemHoverBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource ListItemSelectedBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drag handle. The code-behind finds it by its Tag. -->
                        <Border Grid.Column="0" Tag="DragHandle" Width="24" Background="Transparent"
                                Cursor="SizeAll" ToolTip="Drag to reorder">
                            <Path Data="M0,0h2v2h-2z M5,0h2v2h-2z M0,5h2v2h-2z M5,5h2v2h-2z M0,10h2v2h-2z M5,10h2v2h-2z"
                                  Fill="{DynamicResource SubtextForeground}" SnapsToDevicePixels="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32"
                               Margin="2,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextForeground}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SubtextForeground}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                FontSize="14" Padding="6,4" Margin="4,0,8,0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource DeleteButtonForeground}" Cursor="Hand" ToolTip="Delete shortcut"
                                Click="DeleteButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
