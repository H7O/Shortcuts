<Window x:Class="Shortcuts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shortcuts"
        mc:Ignorable="d"
        Title="Folder Shortcuts" Height="500" Width="420"
        MinHeight="300" MinWidth="320"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackground}"
        Icon="pack://application:,,,/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource ToolbarBorder}" BorderThickness="0,0,0,1">
            <Button x:Name="AddButton" Click="AddButton_Click"
                    FontSize="14" Padding="12,6" HorizontalAlignment="Left" Cursor="Hand"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource ButtonForeground}"
                    BorderBrush="{DynamicResource ButtonBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Add Folder" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" x:Name="EmptyMessage"
                   Text="No shortcuts yet. Click 'Add Folder' to get started."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource EmptyMessageForeground}" FontSize="14" Visibility="Visible"/>

        <!-- Shortcuts list -->
        <ListBox Grid.Row="1" x:Name="ShortcutsList"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="ShortcutsList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ShortcutsList_PreviewMouseMove"
                 Drop="ShortcutsList_Drop"
                 DragOver="ShortcutsList_DragOver"
                 MouseDoubleClick="ShortcutsList_MouseDoubleClick"
                 Background="Transparent">
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource ListItemHoverBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background"
                                                Value="{DynamicResource ListItemSelectedBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextForeground}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SubtextForeground}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                FontSize="14" Padding="6,4" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource DeleteButtonForeground}" Cursor="Hand" ToolTip="Delete shortcut"
                                Click="DeleteButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
